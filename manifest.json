{
  "manifest_version": 3,
  "name": "WanquanZhongwen: Chinese-Chinese Dictionary",
  "short_name": "WanquanZhongwen",
  "version": "5.0.0",
  "description": "A Chinese-Chinese pop-up dictionary. This is a modified version for immersive learning.",
  "icons": {
    "16": "images/zhongwen16.png",
    "48": "images/zhongwen48.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "WanquanZhongwen"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "css/content.css"
      ],
      "js": [
        "js/jquery-3.3.1.min.js",
        "js/zhuyin.js",
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "data/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}